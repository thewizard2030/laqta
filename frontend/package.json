{
  "name": "laqta-frontend",
  "private": true,
  "version": "0.1.2",
  "description": "Laqta studio frontend \u2014 local-first long-video-to-Shorts workbench.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thewizard2030/laqta.git"
  },
  "homepage": "https://github.com/thewizard2030/laqta#readme",
  "bugs": {
    "url": "https://github.com/thewizard2030/laqta/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,json,ts}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "lint:strict": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
