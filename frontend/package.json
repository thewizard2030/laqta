{
  "name": "laqta-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Laqta studio frontend \u2014 local-first long-video-to-Shorts workbench.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thewizard2030/laqta.git"
  },
  "homepage": "https://github.com/thewizard2030/laqta#readme",
  "bugs": {
    "url": "https://github.com/thewizard2030/laqta/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,json,ts}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "lint:strict": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
