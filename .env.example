# ─────────────────────────────────────────────────────────────────────────────
# Laqta — environment configuration
#
# Copy this file to `.env` and edit what you need:
#
#     cp .env.example .env
#
# Every setting is optional: the defaults below are the ones the code uses.
# `.env` is git-ignored and is never committed — it may hold API keys.
#
# All variables use the QATTA_ prefix. They are read by two processes:
#   • the FastAPI backend  (backend/app/core/config.py)
#   • the core pipeline     (qatta/core/config.py)
# Both use the same prefix; the pipeline is the one that matters for
# long-running jobs.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════════════════

# Interface and port. Keep 127.0.0.1 — the API has no authentication.
QATTA_HOST=127.0.0.1
QATTA_PORT=8000

# Allowed browser origins. Never use a wildcard: the API is unauthenticated.
QATTA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# "development" | "production"
QATTA_ENV=development
QATTA_DEBUG=false

# Displayed application name.
QATTA_APP_NAME=Laqta


# ═══════════════════════════════════════════════════════════════════════════
# STORAGE
# ═══════════════════════════════════════════════════════════════════════════

# Where projects, media, transcripts and renders are stored.
# Laqta never uploads this directory anywhere.
QATTA_DATA_DIR=~/.local/share/qatta

# Largest file that may be imported (2 GB).
QATTA_MAX_UPLOAD_SIZE_BYTES=2147483648

# Free disk space that must remain, so a render cannot fill the volume.
QATTA_MIN_FREE_DISK_BYTES=209715200

# Media container formats accepted for import.
QATTA_ALLOWED_MEDIA_EXTENSIONS=.mp4,.mov,.mkv,.webm


# ═══════════════════════════════════════════════════════════════════════════
# JOBS
# ═══════════════════════════════════════════════════════════════════════════

# Worker processes. One keeps the memory profile safe on an 8 GB machine.
QATTA_DEFAULT_JOB_WORKERS=1

# Deadline for a single FFmpeg call (seconds).
QATTA_FFMPEG_TIMEOUT_SECONDS=300

# Delete the intermediate 16 kHz WAV once the transcript exists.
QATTA_CLEAN_INTERMEDIATE_WAV=false


# ═══════════════════════════════════════════════════════════════════════════
# LOCAL SPEECH RECOGNITION (faster-whisper on CPU — the default, no key)
# ═══════════════════════════════════════════════════════════════════════════

# Performance profile: fast | balanced | accurate
#   fast     → base    (~145 MB)  quickest, good for triage
#   balanced → small   (~460 MB)  the default sweet spot
#   accurate → medium  (~1.5 GB)  best quality, slowest on CPU
QATTA_DEFAULT_WHISPER_PROFILE=fast

# Model per profile. Anything on the Hugging Face Hub that faster-whisper
# can load works here.
QATTA_FAST_WHISPER_MODEL=base
QATTA_BALANCED_WHISPER_MODEL=small
QATTA_ACCURATE_WHISPER_MODEL=medium

# Fallback model when no profile-specific one is set.
QATTA_DEFAULT_WHISPER_MODEL=base

# cpu | cuda
QATTA_DEFAULT_WHISPER_DEVICE=cpu

# int8 is the fastest on CPU; float16 needs a GPU.
QATTA_DEFAULT_WHISPER_COMPUTE_TYPE=int8

# Models the UI offers.
QATTA_ALLOWED_WHISPER_MODELS=base,small,medium,large-v3

# 1 = fast greedy decoding (roughly 3× faster than 5 on CPU).
QATTA_WHISPER_BEAM_SIZE=1

# Skip non-speech with the Silero VAD.
QATTA_WHISPER_VAD_FILTER=true

# CPU threads. Lower this if the machine gets sluggish.
QATTA_WHISPER_CPU_THREADS=4


# ═══════════════════════════════════════════════════════════════════════════
# CLIP ALIGNMENT (Pass 2 — word timing for the clips that are rendered)
# ═══════════════════════════════════════════════════════════════════════════

# Re-time words only for the selected clips instead of the whole video.
QATTA_CLIP_ALIGNMENT_ENABLED=true
QATTA_CLIP_ALIGNMENT_MODEL=small
QATTA_CLIP_ALIGNMENT_BEAM_SIZE=5

# Never align a clip longer than this (seconds) — it would stall the worker.
QATTA_MAX_CLIP_ALIGNMENT_SECONDS=120
QATTA_CLIP_ALIGNMENT_COMPUTE_TYPE=int8


# ═══════════════════════════════════════════════════════════════════════════
# TRANSCRIPT CACHE
# ═══════════════════════════════════════════════════════════════════════════

# Content-addressed cache of transcripts. Safe to delete at any time.
QATTA_TRANSCRIPT_CACHE_ENABLED=true


# ═══════════════════════════════════════════════════════════════════════════
# URL INGESTION (yt-dlp) — reads a caption track, downloads selected sections
# ═══════════════════════════════════════════════════════════════════════════
#
# The rights confirmation in the import dialog is mandatory and is shown for
# every import. Setting this to false disables URL import completely — the
# button stays visible but refuses with the reason.
QATTA_ENABLE_URL_INGESTION=true

# Whole-download deadline (seconds).
QATTA_URL_INGEST_TIMEOUT_SECONDS=1800

# Caption languages to prefer. Avoid "all" — it triggers YouTube rate limits.
QATTA_URL_INGEST_SUB_LANGUAGES=ar.*,ar,en.*,en

# Use YouTube's own caption track instead of transcribing the audio.
QATTA_ENABLE_NATIVE_YOUTUBE_TRANSCRIPT=true

# Fall back to local transcription when a video has no caption track.
QATTA_AUTO_TRANSCRIBE_ON_INGEST_FALLBACK=true

# yt-dlp client profiles to try, in order.
QATTA_YT_DLP_PLAYER_CLIENT=android,ios,web

# Cookie file for age- or login-restricted videos. Leave empty for none.
#QATTA_YT_DLP_COOKIES_PATH=

# Read the cookies from a local browser instead of a file: firefox, chrome,
# chromium, edge, brave, opera, safari, vivaldi, whale.
#QATTA_YT_DLP_COOKIES_FROM_BROWSER=

# How long the yt-dlp capability probe may take (seconds).
QATTA_YT_DLP_PROBE_TIMEOUT_SECONDS=10


# ═══════════════════════════════════════════════════════════════════════════
# HOSTED LLM (OPTIONAL) — reranks the clip candidates
# ═══════════════════════════════════════════════════════════════════════════
#
# ⚠ With a hosted provider the transcript text of the window being scored
#   LEAVES THIS DEVICE. The UI discloses it. Without a key the deterministic
#   local ranker is used and nothing is uploaded.
#
# Two flags are required: QATTA_ALLOW_CLOUD_APIS and QATTA_LLM_HOSTED_OPT_IN.

# Enable the optional LLM reranker at all.
QATTA_LLM_RANKER_ENABLED=false

# A hosted provider additionally needs this explicit consent.
QATTA_LLM_HOSTED_OPT_IN=false

# The master switch for every cloud path.
QATTA_ALLOW_CLOUD_APIS=false

# Provider: ollama | gemini | openai_compatible | openrouter
QATTA_LLM_PROVIDER=openai_compatible

# A local OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM).
QATTA_LLM_BASE_URL=http://127.0.0.1:11434/v1
QATTA_LLM_MODEL=qwen2.5:7b-instruct

# Secret for gemini / openai_compatible. Never logged, never returned by the API.
#QATTA_LLM_API_KEY=

# OpenRouter (Unlicense for yt-dlp / MIT for the API): free models end in ":free".
#QATTA_LLM_OPENROUTER_API_KEY=
QATTA_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QATTA_LLM_OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# Public attribution headers (not secrets) shown on OpenRouter's dashboard.
QATTA_LLM_OPENROUTER_SITE_URL=http://127.0.0.1:5173
QATTA_LLM_OPENROUTER_APP_TITLE=Laqta

# Bounds on the reranker.
QATTA_LLM_TIMEOUT_SECONDS=20
QATTA_LLM_MAX_OUTPUT_TOKENS=1200
QATTA_LLM_MAX_RETRIES=1
QATTA_LLM_MAX_CANDIDATES=12


# ═══════════════════════════════════════════════════════════════════════════
# CLOUD TRANSCRIPTION (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════
#
# The same two flags apply: QATTA_ALLOW_CLOUD_APIS and the provider key.
# The audio of the segment is uploaded to the provider when enabled.

# Secret for Groq.
#QATTA_GROQ_API_KEY=
QATTA_GROQ_MODEL=whisper-large-v3-turbo
QATTA_GROQ_BASE_URL=https://api.groq.com/openai/v1
QATTA_GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Secret for AssemblyAI.
#QATTA_ASSEMBLYAI_API_KEY=

# Hugging Face token for gated models. Secret.
#QATTA_HF_TOKEN=
QATTA_HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# A whisper.cpp binary and model, for machines without the faster-whisper wheels.
#QATTA_WHISPER_CPP_PATH=
#QATTA_WHISPER_CPP_MODEL_PATH=


# ═══════════════════════════════════════════════════════════════════════════
# CORE PIPELINE (the manifest stages)
# ═══════════════════════════════════════════════════════════════════════════

# Transcription backend used by the core pipeline:
#   local_turbo        (default) local faster-whisper, fast greedy decoding
#   groq_api           hosted — needs QATTA_ALLOW_CLOUD_APIS=true and a key
#   youtube_subs_first YouTube's own caption track, no media download
QATTA_TRANSCRIPTION_BACKEND=local_turbo

# The same choice for the backend's own transcription manager.
QATTA_DEFAULT_TRANSCRIPTION_BACKEND=faster-whisper

# The heavy turbo model. On an 8 GB machine prefer a smaller one.
QATTA_TURBO_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
QATTA_TURBO_BATCH_SIZE=
QATTA_TURBO_COMPUTE_TYPE=
QATTA_TURBO_BEAM_SIZE=1

# Keep English technical terms in Latin script in Arabic speech.
QATTA_ARABISH_INITIAL_PROMPT=true
#QATTA_ARABISH_PROMPT_TEXT=

# Caption languages to look for on YouTube.
QATTA_YOUTUBE_SUB_LANGUAGES=ar,en
QATTA_YOUTUBE_FETCH_TIMEOUT_SECONDS=120

# The core pipeline reads the same QATTA_LLM_* variables as the backend
# (they are separate processes sharing one prefix).
QATTA_LLM_FALLBACK_ENABLED=true

# Clip boundaries.
QATTA_MIN_CLIP_SEC=28
QATTA_MAX_CLIP_SEC=58
QATTA_VIDEO_MAX_CLIP_SEC=180
QATTA_MAX_WINNERS=5
QATTA_BOUNDARY_PAUSE_MS=200
QATTA_BOUNDARY_RMS_CONTRAST=1.25
QATTA_SNAP_SEARCH_MS=3000
QATTA_PAUSE_SPLIT_MS=350

# Pass 2 (fine) timing.
QATTA_FINE_PADDING_MS=2000
QATTA_FINE_BEAM_SIZE=2
QATTA_SNAP_PAD_MS=120

# Long-video windowing.
QATTA_SLIDING_WINDOW_SEC=900
QATTA_SLIDING_OVERLAP_SEC=120

# Groq chunking (only used with the cloud backend).
QATTA_GROQ_CHUNK_SECONDS=900
QATTA_GROQ_MAX_CONCURRENCY=4
QATTA_GROQ_TIMEOUT_SECONDS=120

QATTA_FFPROBE_TIMEOUT_SECONDS=30
